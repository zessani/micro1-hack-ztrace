#!/bin/bash
set -u

usage() {
    echo "usage: ztrace-run [--root-is-command] -- <cmd...>" >&2
    exit 2
}

root_is_command=0
if [ "${1:-}" = "--root-is-command" ]; then
    root_is_command=1
    shift
fi
[ "${1:-}" = "--" ] || usage
shift
[ $# -gt 0 ] || usage

trace_dir=${ZTRACE_DIR:-/trace}
trace_user=${ZTRACE_USER:-agent}

mkdir -p "$trace_dir"
chown root:root "$trace_dir" 2>/dev/null
chmod 700 "$trace_dir"

{
    echo "version=0.1"
    echo "root_is_command=$root_is_command"
    echo "cwd=$(pwd -P)"
    echo "start=$(date +%s.%N)"
} > "$trace_dir/ztrace.meta"

user_home=$(getent passwd "$trace_user" | cut -d: -f6)
export HOME=${user_home:-/home/$trace_user} USER=$trace_user LOGNAME=$trace_user

syscalls='execve,execveat,clone,clone3,?fork,?vfork,exit_group,chdir,fchdir,?open,openat,?creat,?rename,renameat,renameat2,?unlink,unlinkat,?mkdir,mkdirat,connect,getsockopt,write,writev'

strip_data='/^[0-9]+ +[0-9.]+ write\((0|[3-9]|[0-9]{2,})[<,]/s/, ".*"(\.\.\.)?, ([0-9]+)(\)| <unfinished)/, "", \2\3/
/^[0-9]+ +[0-9.]+ writev\((0|[3-9]|[0-9]{2,})[<,]/s/, \[\{.*\}\](\.\.\.)?, ([0-9]+)(\)| <unfinished)/, [], \2\3/'

exec strace -f -q -ttt -y -s 65536 -e signal=none -e trace="$syscalls" \
    -u "$trace_user" -o "|sed -E '$strip_data' > '$trace_dir/trace.log'" -- "$@"
