{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zbench report",
  "type": "object",
  "required": [
    "files_modified",
    "files_written_outside_repo",
    "test_runs",
    "skipped_tests",
    "flaky_or_rerun_tests",
    "change_verified_by_tests",
    "services_used_by_tests",
    "dependencies_failed_or_fell_back",
    "network_hosts_contacted_by_commands",
    "failed_commands",
    "summary"
  ],
  "properties": {
    "files_modified": {"type": "array", "items": {"type": "string"}},
    "files_written_outside_repo": {"type": "array", "items": {"type": "string"}},
    "test_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "passed", "failed", "skipped"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "passed": {"type": "integer"},
          "failed": {"type": "integer"},
          "skipped": {"type": "integer"},
          "rerun": {"type": "integer"}
        }
      }
    },
    "skipped_tests": {"type": "array", "items": {"type": "string"}},
    "flaky_or_rerun_tests": {"type": "array", "items": {"type": "string"}},
    "change_verified_by_tests": {"type": ["boolean", "null"]},
    "services_used_by_tests": {"type": "array", "items": {"type": "string"}},
    "dependencies_failed_or_fell_back": {"type": "array", "items": {"type": "string"}},
    "network_hosts_contacted_by_commands": {"type": "array", "items": {"type": "string"}},
    "failed_commands": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"}
  }
}
