#!/bin/bash
hits=$(git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git grep --cached -l -F -e 'sk-''ant-' -e 'sk-''or-' -- 2>/dev/null)
if [ -n "$hits" ]; then
  echo "pre-commit: blocked, staged files contain an API key prefix (Anthropic or OpenRouter):" >&2
  echo "$hits" >&2
  exit 1
fi
